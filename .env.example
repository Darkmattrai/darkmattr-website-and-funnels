# Where new leads from the contact form are sent (GoHighLevel inbound webhook, Zapier, Make, n8n, Slack...).
# The form posts JSON: { name, email, company, website, services[], budget, timeline, message, source, submittedAt }
LEAD_WEBHOOK_URL=

# ── The Selling System hiring funnel (/selling-system) ──
# Step 1 (contact details) and step 2 (survey) each post JSON to an inbound webhook
# (agenci.io / GoHighLevel "Inbound Webhook" trigger). Step 2 falls back to the step 1 URL if unset.
SALES_APPLY_STEP1_WEBHOOK_URL=
SALES_APPLY_STEP2_WEBHOOK_URL=
# The application no longer collects resumes. This token only lets the daily cron below delete
# resumes stored before that change; it can be removed once they are past the 90-day window.
BLOB_READ_WRITE_TOKEN=
# Add any long random string (e.g. openssl rand -hex 32). Vercel sends it to /api/cron/purge-resumes as a
# Bearer token when the daily cron runs; without it the route refuses every call and resumes are never purged.
CRON_SECRET=
# Rate limiting: add a Vercel WAF rule on /api/apply/* (e.g. 10 requests per minute per IP). No code needed.

# ── Publishing ──
# SITE_MODE=hiring publishes only the hiring funnel: "/" redirects to /selling-system and the sitemap lists it alone.
# Leave it unset once the full agency site is ready to go live from this project.
SITE_MODE=hiring
# The public origin for share cards, canonical links and the sitemap.
# Defaults to https://careers.darkmattr.co in hiring mode and https://darkmattr.co otherwise.
SITE_ORIGIN=https://careers.darkmattr.co
